# Imagem do backend para o Fly.io.
#
# Diferenças em relação ao Dockerfile.vercel:
#
# - sem socat. Na Vercel o container recebe a porta publica em $PORT e o wrapper
#   start-vercel.sh redirecionava para a porta interna da aplicacao. No Fly a
#   porta e declarada em fly.toml (internal_port) e o processo escuta nela
#   direto, então o proxy extra deixa de existir - um processo a menos e um
#   ponto de falha a menos.
# - PORT fixo em 8080, casando com internal_port do fly.toml. O application.yml
#   ja le ${PORT}.
FROM maven:3.9.11-eclipse-temurin-21-alpine AS build

WORKDIR /app

COPY pom.xml .
RUN mvn --batch-mode --no-transfer-progress dependency:go-offline

COPY src ./src
RUN mvn --batch-mode --no-transfer-progress package

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

COPY --from=build /app/target/hackgov-api-1.0.0-SNAPSHOT.jar app.jar

ENV PORT=8080

EXPOSE 8080

# MaxRAMPercentage em vez de -Xmx fixo: a JVM respeita o limite declarado em
# fly.toml ([[vm]] memory) sem precisar repetir o numero aqui.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
