# Em produção, use "/" para chamar a API Java no mesmo domínio da Vercel.
# Esta é a única configuração lida pelo frontend e não contém segredo.
VITE_API_URL=http://localhost:5206

# Configurações privadas lidas exclusivamente pela API Java.
# Use a conexão Session Pooler exibida em "Connect" no Supabase.
SPRING_DATASOURCE_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
JWT_SECRET=<random-secret-with-at-least-32-characters>
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app
SPRING_MAIN_LAZY_INITIALIZATION=false
SPRING_DATA_JPA_REPOSITORIES_BOOTSTRAP_MODE=default
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
APP_SCHEDULING_ENABLED=true

# A API Java chama a Edge Function de classificação; estas variáveis nunca vão ao navegador.
SUPABASE_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/classify-priority
SUPABASE_ANON_KEY=<supabase-anon-key>
