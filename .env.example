# Local: o frontend chama a API Java local.
# Producao na Vercel: use "/" para chamar /api pelo mesmo dominio do frontend.
# Esta e a unica configuracao lida pelo frontend e nao contem segredo.
VITE_API_URL=http://localhost:5206

# Configuracoes privadas lidas exclusivamente pela API Java.
# Em producao, configure como secrets/variaveis protegidas no Fly/Vercel.
# Nunca use prefixo VITE_ para senhas, JWT, chaves Supabase ou URLs internas de banco.
SPRING_DATASOURCE_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
JWT_SECRET=<random-secret-with-at-least-32-characters>

# Liste apenas origens reais. Nao use wildcard (*).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app

SPRING_MAIN_LAZY_INITIALIZATION=false
SPRING_DATA_JPA_REPOSITORIES_BOOTSTRAP_MODE=default
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
APP_SCHEDULING_ENABLED=true

# Limite de tentativas falhas de login dentro da janela configurada.
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_IP=30
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_CPF=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# A API Java chama a Edge Function de classificacao; estas variaveis nunca vao ao navegador.
SUPABASE_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/classify-priority
SUPABASE_ANON_KEY=<supabase-anon-key>

# Edicao de fotos por IA. Se a URL ficar vazia, a API deriva o endereco a partir
# de SUPABASE_EDGE_FUNCTION_URL, trocando classify-priority por generate-corrected-image.
SUPABASE_CORRECTED_IMAGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/generate-corrected-image
AI_IMAGE_FUNCTION_SECRET=<random-secret-shared-with-the-edge-function>
