{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cidadao-informa-api.fly.dev/api/$1"
    },
    {
      "source": "/swagger",
      "destination": "https://cidadao-informa-api.fly.dev/swagger"
    },
    {
      "source": "/swagger/(.*)",
      "destination": "https://cidadao-informa-api.fly.dev/swagger/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}